-- Appended by scripts/toolchain_bump/statement_types.py after the project library's import. Writes, for every theorem
-- declared in a module under the project library, its name and its fully elaborated statement (`pp.all`,
-- one line) to STATEMENT_TYPES_OUT. Two toolchains' outputs are compared line by line: any difference is a
-- statement whose elaborated meaning changed (coercions, instances, unfolding), whatever its source text.
open Lean Elab Command Meta

run_cmd do
  let env ← getEnv
  let lib := "PROJECT_LIB".toName
  let mut rows : Array String := #[]
  for (n, ci) in env.constants.toList do
    let some i := env.getModuleIdxFor? n | continue
    -- private theorems are statements someone wrote too (their names are internal only by mangling)
    unless lib.isPrefixOf env.header.moduleNames[i.toNat]! && ci.isTheorem && (!n.isInternal || isPrivateName n) do continue
    -- equation, injectivity, sizeOf, congruence and auxiliary (`_proof_n`, `_simp_n`, `match_n`) lemmas are
    -- generated by the compiler, and their names and shapes differ between toolchains: they are not
    -- statements anyone wrote. Structure fields that are propositions (`Env.hpos`) are kept.
    let user := (privateToUserName? n).getD n
    let last := match user with | .str _ s => s | _ => ""
    if last.startsWith "eq_" || last == "inj" || last == "injEq" || last == "sizeOf_spec" || last == "congr_simp" then continue
    if user.components.any (fun c => let t := c.toString; t.startsWith "_" || t.startsWith "match_") then continue
    let fmt ← liftTermElabM <| withOptions (fun o => o.setBool `pp.all true) <| ppExpr ci.type
    rows := rows.push s!"{n}\t{(toString fmt).replace "\n" " "}"
  IO.FS.writeFile "STATEMENT_TYPES_OUT" (String.intercalate "\n" (rows.qsort (· < ·)).toList ++ "\n")
  IO.println s!"STATEMENT-TYPES {rows.size}"
